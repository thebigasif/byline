<form class="form" method="post" action="/forms/contact">
<p><label for="contact-name">Your name</label>
<input id="contact-name" name="name" type="text" required /></p>
<p><label for="contact-reply_to">Your email address</label>
<input id="contact-reply_to" name="reply_to" type="email" required /></p>
<p><label for="contact-message">What can we help with?</label>
<textarea id="contact-message" name="message" required></textarea></p>
<p><label for="contact-company">Company</label>
<input id="contact-company" name="company" type="text" /></p>
<p class="form-trap" aria-hidden="true"><label for="contact-homepage">Leave this empty</label>
<input id="contact-homepage" name="homepage" type="text" tabindex="-1" autocomplete="off" /></p>
<p><button type="submit">Send</button></p>
</form>
