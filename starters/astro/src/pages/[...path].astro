---
// One page per post, at the address Khalid gives it, such as
// /blog/what-a-sitemap-does/ or /blog/de/was-eine-sitemap-leistet/. The
// head is the one Khalid's theme writes, so meta tags and schema match.
import Base from "../layouts/Base.astro";
import { getPost, getPosts, routeOf, siteFrom } from "../lib/khalid.js";

export async function getStaticPaths() {
  const site = siteFrom(import.meta.env);
  const posts = await getPosts(site);
  return posts.map((post) => ({
    params: { path: routeOf(post, import.meta.env.BASE_URL) },
    props: { id: post.id },
  }));
}

const post = await getPost(siteFrom(import.meta.env), Astro.props.id);
if (!post) {
  throw new Error(
    `Khalid listed the post ${Astro.props.id} but did not find it a moment later. ` +
      "It was probably unpublished during the build. Build again.",
  );
}
---

<Base lang={post.language} head={post.head} title={post.title}>
  <article>
    <h1>{post.title}</h1>
    <p>
      <time datetime={post.published_at}>{post.published_at.slice(0, 10)}</time>
    </p>
    <Fragment set:html={post.html} />
  </article>
</Base>
